# =============================================================================
# WealthNest Configuration
# =============================================================================

# =============================================================================
# Production Server
# =============================================================================
PORT=8000
WEALTHNEST_DATA_DIR=./backend/data/prod
# Data is stored in: <WEALTHNEST_DATA_DIR>/sqlite/app.db, custom-uploads/, broker_reports/, logs/
# If you want a different location (e.g. Docker volume), change the path above.

# =============================================================================
# Test Server (used by ./dev.py server --test and automated tests)
# =============================================================================
TEST_PORT=8001
# Test mode is activated via: ./dev.py server --test (sets WEALTHNEST_TEST_MODE=1)
# In test mode, data directory is ALWAYS backend/data/test/ (ignores WEALTHNEST_DATA_DIR)

# =============================================================================
# Logging
# =============================================================================
LOG_LEVEL=INFO

# =============================================================================
# Portfolio
# =============================================================================
PORTFOLIO_BASE_CURRENCY=INR

# =============================================================================
# Image Preview Cache
# =============================================================================
# Max size in MB for in-memory image preview cache (per-process, default: 50)
PREVIEW_CACHE_MAX_MB=50

# =============================================================================
# CORS (for frontend development with HMR on :5173)
# =============================================================================
BACKEND_CORS_ORIGINS=["http://localhost:3000", "http://localhost:5173"]
# Public URL used in email links like nominee access.
# For the standard local setup, the backend serves the built frontend on :8000.
FRONTEND_BASE_URL=http://localhost:8000

# =============================================================================
# Nominee Email Alerts
# =============================================================================
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_USE_TLS=true
NOMINEE_EMAIL_FROM=
NOMINEE_CHECK_INTERVAL_MINUTES=60
# Optional override for short demos. If > 0, this is used instead of NOMINEE_CHECK_INTERVAL_MINUTES.
NOMINEE_CHECK_INTERVAL_SECONDS=0
NOMINEE_ACCESS_TOKEN_TTL_HOURS=72
